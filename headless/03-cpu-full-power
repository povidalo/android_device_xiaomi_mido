#!/system/bin/sh
# Headless ROM boot script (mido): the CPU at full power at all times.
#
#   - all 8 cores online, governor 'performance' (top frequency);
#   - no CPU low-power modes: lpm_levels sleep_disabled, so idle cores stay
#     powered instead of power-collapsing. The kernel command line boots with
#     it set; init.qcom.post_boot.sh clears it when boot completes;
#   - core_ctl, where present, may not park cores.
#
# Thermal protection is left alone: thermal-engine and msm_thermal may still
# cap the frequency, or take a core offline, when the SoC gets too hot. So
# cores are put online once, after post_boot, and not forced back later.
# Suspend, Doze and Wi-Fi power save are off already (vendor/headless: the
# kernel wakelock in sud.rc, 02-stay-awake, the overlays, and this device's
# WCNSS_qcom_cfg.ini).
#
# post_boot starts on the same trigger (sys.boot_completed=1) and undoes some
# of this, so wait until it has finished, then apply. A background loop
# re-applies the governor, core_ctl and the low-power-mode switch every 30 s
# in case the perf HAL or anything else changes them, and logs it when it
# does. To leave the CPU to the vendor settings:
#   setprop persist.headless.cpu_full_power 0   (then reboot)

LOG=/data/local/boot.d.log
LPM=/sys/module/lpm_levels/parameters/sleep_disabled

log() { echo "$(date '+%F %T') 03-cpu-full-power: $*" >>"$LOG"; }

if [ "$(getprop persist.headless.cpu_full_power)" = 0 ]; then
    echo "03-cpu-full-power: off (persist.headless.cpu_full_power=0)"
    exit 0
fi

settings() { # governor, core_ctl, low-power modes; prints what it changed
    changed=
    for g in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do
        [ -f "$g" ] && [ "$(cat "$g")" != performance ] || continue
        cpu=${g%/cpufreq/*}
        echo performance >"$g" 2>/dev/null && changed="$changed ${cpu##*/}:performance"
    done
    for c in /sys/devices/system/cpu/cpu[0-9]*/core_ctl; do
        [ -f "$c/min_cpus" ] || continue
        max=$(cat "$c/max_cpus")
        [ "$(cat "$c/min_cpus")" = "$max" ] && continue
        cpu=${c%/core_ctl}
        echo "$max" >"$c/min_cpus" 2>/dev/null && changed="$changed ${cpu##*/}:core_ctl=$max"
    done
    if [ -f "$LPM" ] && [ "$(cat "$LPM")" != Y ]; then
        echo Y >"$LPM" 2>/dev/null && changed="$changed lpm:off"
    fi
    echo "$changed"
}

state() {
    echo "online $(cat /sys/devices/system/cpu/online)," \
        "governor $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)," \
        "cpu0 $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null) kHz" \
        "(max $(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null))," \
        "lpm sleep_disabled=$(cat "$LPM" 2>/dev/null)"
}

(
    i=0
    while [ "$(getprop init.svc.vendor.qcom-post-boot)" != stopped ] && [ $i -lt 120 ]; do
        sleep 1
        i=$((i + 1))
    done
    for o in /sys/devices/system/cpu/cpu[0-9]*/online; do
        [ "$(cat "$o")" = 1 ] || echo 1 >"$o" 2>/dev/null
    done
    settings >/dev/null
    log "applied ${i}s after boot completed (post_boot $(getprop init.svc.vendor.qcom-post-boot)): $(state)"
    while :; do
        sleep 30
        c=$(settings)
        [ -n "$c" ] && log "re-applied:$c; $(state)"
    done
) </dev/null >/dev/null 2>&1 &
